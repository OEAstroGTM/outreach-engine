{
  "_readme": "SEED — durable configuration for the observability module. Committed to git. On first run the collector copies this to history.json (gitignored) and appends snapshots there. Edit this file when config changes: a client churns, a label is added, the fleet is re-inventoried. Never add snapshots or scan results here — those belong in the live file.",
  "_schema": {
    "totals": "workspace_id -> total thread count (from get_prospects metadata.total)",
    "labels": "workspace_id -> { label_name -> prospect_count }. Currently only 1013 is available; get_label_stats ignores its label_id argument and always returns workspace 1013. When the MCP gains a workspace param, populate this for every workspace.",
    "notes": "free-text anomalies worth preserving",
    "churned": "workspace_id -> {name, churned_on}. Excluded from the dashboard and from all current counts. Their figures remain in historical snapshots so past totals stay truthful — never strip them from snapshots.",
    "internal": "workspace_id -> {name, reason}. Infrastructure workspaces, not clients. Excluded from the dashboard and all client counts. Distinct from 'churned'.",
    "taxonomy": "Canonical grouping of label names. 'interest' is the funnel entry pool — all three labels are equivalent expressions of interest. 'success' is TERMINAL: a thread ends at Meeting Booked. 'setter_activity' labels are outbound call attempts by the appointment setter, NOT downstream funnel stages — never chain them after Meeting Booked.",
    "platforms": "Sending platforms and their workspace IDs. Three systems: bison_send, bison_personal, instantly.",
    "mapping_gaps": "Known joins that do not resolve between MasterInbox and the sending platforms. Review before trusting any cross-system rate.",
    "infrastructure_baseline": "Input-side (mailbox/domain) observations. Separate from reply-side snapshots.",
    "client_registry": "Authoritative client map from the oe repo's clients.json: MasterInbox ws id, EmailBison ws id, sequencer, per-client MI key env var. Use this for all joins.",
    "pilot_a1": "Results of the first per-client scan pilot. Validates the four-outputs-per-scan design and bounds its cost.",
    "observed": "Per-client scan output: group funnel, domain attribution, awaiting-reply queue. Distinct from 'labels', which is per-label and only available for ws 1013.",
    "registrar_pull": "Domain age data from registrars. Partial: NameSilo key is dead, so .digital/.xyz sending domains are unaged.",
    "domain_ages": "full domain -> age in days. Consumed by infra triage; absent domains show age unknown.",
    "inboxing_tag_map": "workspace_id -> Inboxing tag, for joining reply outcomes to the sending fleet."
  },
