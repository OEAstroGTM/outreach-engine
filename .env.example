# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Apollo.io — contact research & enrichment
APOLLO_API_KEY=your_apollo_api_key_here

# EmailBison (Send instance)
EMAILBISON_SEND_URL=https://send.outreachenginedashboard.co
EMAILBISON_SEND_API_KEY=your_eb_send_api_key_here

# EmailBison (Personal instance)
EMAILBISON_PERSONAL_URL=https://personal.outreachenginedashboard.co
EMAILBISON_PERSONAL_API_KEY=your_eb_personal_api_key_here

# Instantly (per-workspace API keys)
INSTANTLY_SUPPLY_WISDOM_API_KEY=your_instantly_supply_wisdom_key_here
INSTANTLY_LEND_HOME_API_KEY=your_instantly_lend_home_key_here
INSTANTLY_SURETY_NOW_API_KEY=your_instantly_surety_now_key_here

# MasterInbox — master key
MASTERINBOX_API_KEY=your_masterinbox_master_key_here
# MasterInbox — per-workspace public keys (pk_...)
MI_KEY_ASKTURING=pk_...
MI_KEY_BRAINTRACKS=pk_...
MI_KEY_BRAVURA_TECHNOLOGIES=pk_...
MI_KEY_CHALKTALK=pk_...
MI_KEY_COFFEE_AND_CONTRACTS=pk_...
MI_KEY_DREAM_IT_REEL=pk_...
MI_KEY_HUBENGAGE=pk_...
MI_KEY_INTELLECTIBLE=pk_...
MI_KEY_LEND_HOME_IMPROVEMENTS=pk_...
MI_KEY_NUVO_BATH=pk_...
MI_KEY_OR_TRAX=pk_...
MI_KEY_OUTREACH_ENGINE=pk_...
MI_KEY_PARGO=pk_...
MI_KEY_SAVANTI_TRAVEL=pk_...
MI_KEY_SIMPLEXITY=pk_...
MI_KEY_SUPPLY_WISDOM=pk_...
MI_KEY_TRUE_DIAL=pk_...
MI_KEY_WESTLINK=pk_...
MI_KEY_CARENGEN=pk_...
MI_KEY_CLININTELL=pk_...
MI_KEY_ABRA=pk_...
MI_KEY_REVO=pk_...
MI_KEY_UJET=pk_...
MI_KEY_ARNON_RIVER_PARTNERS=pk_...
MI_KEY_CAMPAYGN=pk_...
MI_KEY_UNION_OMAHA=pk_...
# MasterInbox — session JWT (needed for bulk-upload; expires periodically)
MI_JWT=your_masterinbox_jwt_here

# Porkbun
PORKBUN_API_KEY=your_porkbun_api_key_here
PORKBUN_SECRET_API_KEY=your_porkbun_secret_key_here

# Winnr
WINNR_LEND_HOME_API_KEY=your_winnr_lend_home_key_here

# ── Infra agent — registrars (self-sufficient, no external MCP) ──────────────
# Pick the registrar the Infra agent uses. NameSilo and Porkbun are both native.
INFRA_REGISTRAR=namesilo             # namesilo (default) | porkbun
NAMESILO_API_KEY=your_namesilo_api_key_here
# PORKBUN_API_KEY / PORKBUN_SECRET_API_KEY are defined in the Porkbun section above.

# ── Inboxing (mailbox provisioning — Inboxing API v2, X-API-Key auth) ────────
INBOXING_API_KEY=your_inboxing_api_key_here            # Dashboard > Settings > API
INBOXING_API_BASE_URL=https://v2.inboxing.com/api/v2   # dashboard host + /api/v2 (NOT app.inboxing.com — that host hangs and surfaces as HTTP 522)

# ── Agent runtime (delegating sub-agents in mcp/) ────────────────────────────
# The MCP exposes run_<orchestrator|research|campaign|inbox|infra>_agent tools.
# Each runs an Anthropic tool-use loop, so ANTHROPIC_API_KEY above is required.
AGENT_MODEL=claude-sonnet-4-6        # optional; default claude-sonnet-4-6
AGENT_MAX_TURNS=25                   # optional; safety cap on tool-use turns
AGENT_MAX_TOKENS=4096                # optional; per-turn max tokens
